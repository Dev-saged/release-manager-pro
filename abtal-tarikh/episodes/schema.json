{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abtal-tarikh/episodes/schema.json",
  "title": "أبطال في التاريخ — حلقة",
  "type": "object",
  "required": ["id", "number", "title", "hero", "cast", "scenes"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ep(0\\d|10)$" },
    "number": { "type": "integer", "minimum": 0, "maximum": 10 },
    "title": { "type": "string", "minLength": 1 },
    "hero": {
      "type": "object",
      "required": ["name", "era"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "era": { "type": "string", "minLength": 1 },
        "place": { "type": "string" }
      }
    },
    "target_seconds": { "type": "integer", "minimum": 120, "maximum": 180 },
    "cast": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/voice" }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "voice": {
      "type": "object",
      "required": ["role"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}-[A-Za-z]+Neural$" },
        "rate": { "type": "string", "pattern": "^[+-]\\d+%$" },
        "pitch": { "type": "string", "pattern": "^[+-]\\d+Hz$" }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "setting", "lines"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^s\\d{2}$" },
        "setting": { "type": "string", "minLength": 1 },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/line" }
        }
      }
    },
    "line": {
      "type": "object",
      "required": ["speaker", "text_diacritized", "sfx", "visual_beat"],
      "additionalProperties": false,
      "properties": {
        "speaker": { "$ref": "#/$defs/id" },
        "text_diacritized": { "type": "string", "minLength": 1 },
        "sfx": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "visual_beat": { "type": "string", "minLength": 1 }
      }
    }
  }
}
